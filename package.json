{
	"name": "jw-bible-linker",
	"version": "0.1.0",
	"description": "Obsidian plugin: Bible references to JW Library links",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild test/parser.test.ts --bundle --platform=node --format=cjs | node"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.24.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.4.0"
	}
}
